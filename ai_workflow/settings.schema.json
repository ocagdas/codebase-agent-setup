{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "codebase-agent-setup settings 1.0",
  "description": "Scope rules are additionally checked by the runtime resolver: projects only in user files, repository_id only in shared project files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "projects": {
      "type": "object",
      "propertyNames": {
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/settings"
      }
    }
  },
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tooling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "enum": [
                    "venv",
                    "native",
                    "conda"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "env_dir": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            },
            "conda_name": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "integrations": {
              "anyOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": [
                      "codex",
                      "cursor-agent",
                      "copilot"
                    ]
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "anyOf": [
                {
                  "enum": [
                    "source",
                    "index",
                    "auto"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "base_refs": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "cache_root": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "repository_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "indexers": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "store": {
              "anyOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "handover": {
          "type": "object",
          "additionalProperties": false,
          "description": "Handover document agents read and update; relative paths resolve against the declaring file; null uses HANDOVER.md in the repository.",
          "properties": {
            "path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
