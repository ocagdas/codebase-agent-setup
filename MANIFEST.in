include LICENSE NOTICE.md *.md Makefile pyproject.toml
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github *.yml *.yaml *.md
recursive-exclude * __pycache__ *.py[cod]
global-exclude settings.local.json
recursive-include docs *.md
include .github/CODEOWNERS
recursive-include standards *
include repository-standard.json

include BRANCHING.md

include requirements*.txt environment.yml
include src/build_support.py
recursive-include src/codebase_agent_setup *.py
recursive-include project *.py *.md *.mdc *.json *.yaml LICENSE
